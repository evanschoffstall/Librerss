generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("SUPABASE_URL")
  directUrl    = env("SUPABASE_DIRECT_URL")
  relationMode = "prisma"
}

model Feed {
  id           Int            @id @default(autoincrement())
  url          String         @unique
  last_fetched DateTime       @default(dbgenerated("(now() - '1 day'::interval)"))
  articles     Article[]
  categories   FeedCategory[]
}

model Article {
  id               Int      @id @default(autoincrement())
  title            String
  link             String   @unique
  publication_date DateTime
  content          String
  feed_id          Int
  last_checked     DateTime @default(now())
  feed             Feed     @relation(fields: [feed_id], references: [id])
}

model FeedSource {
  id   Int    @id @default(autoincrement())
  name String @unique
  url  String
}

model FeedCategory {
  id       Int    @id @default(autoincrement())
  feed_id  Int
  category String
  feed     Feed   @relation(fields: [feed_id], references: [id])
}
