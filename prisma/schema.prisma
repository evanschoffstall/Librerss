datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Feed {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  url         String
  last_fetched DateTime @default(dbgenerated("now() - interval '1 day'"))
  articles    Article[]
  categories  FeedCategory[]
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String
  link            String   @unique
  publication_date DateTime
  content         String
  feed_id         Int
  feed            Feed     @relation(fields: [feed_id], references: [id])
  last_checked    DateTime @default(now())
}

model FeedSource {
  id   Int    @id @default(autoincrement())
  name String @unique
  url  String
}

model FeedCategory {
  id       Int    @id @default(autoincrement())
  feed_id  Int
  feed     Feed   @relation(fields: [feed_id], references: [id])
  category String
}

@@index([url], name: "idx_feed_url")
@@index([link], name: "idx_article_link")
@@index([feed_id], name: "idx_article_feed_id")
