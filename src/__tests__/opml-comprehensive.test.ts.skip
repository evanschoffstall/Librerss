/**
 * Comprehensive Tests: OPML Import Utilities
 * Tests for src/lib/utils/opml.ts
 */

import { parseOpmlFeedImport } from "@/lib/utils/opml";
import { describe, expect, test } from "bun:test";

describe("OPML Parser - Basic Functionality", () => {
  test("parses simple OPML with single feed", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Test Feed" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].name).toBe("Test Feed");
    expect(result[0].url).toBe("https://example.com/feed");
  });

  test("parses OPML with multiple feeds", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed 1" xmlUrl="https://example.com/feed1" />
          <outline text="Feed 2" xmlUrl="https://example.com/feed2" />
          <outline text="Feed 3" xmlUrl="https://example.com/feed3" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(3);
    expect(result[0].name).toBe("Feed 1");
    expect(result[1].name).toBe("Feed 2");
    expect(result[2].name).toBe("Feed 3");
  });

  test("parses OPML with categorized feeds", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Technology">
            <outline text="Tech Blog" xmlUrl="https://example.com/tech" />
            <outline text="Dev News" xmlUrl="https://example.com/dev" />
          </outline>
          <outline text="News">
            <outline text="World News" xmlUrl="https://example.com/world" />
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(3);
    expect(result[0].category).toBe("Technology");
    expect(result[1].category).toBe("Technology");
    expect(result[2].category).toBe("News");
  });

  test("parses nested categories", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Tech">
            <outline text="Programming">
              <outline text="JavaScript" xmlUrl="https://example.com/js" />
            </outline>
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].category).toBe("Programming");
  });

  test("uses default category for uncategorized feeds", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Orphan Feed" xmlUrl="https://example.com/orphan" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].category).toBe("Uncategorized");
  });
});

describe("OPML Parser - Label Handling", () => {
  test("uses text attribute for feed name", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Text Feed" title="Title Feed" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("Text Feed");
  });

  test("falls back to title attribute when text is missing", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline title="Title Feed" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("Title Feed");
  });

  test("uses URL as name when both text and title are missing", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("https://example.com/feed");
  });

  test("uses 'Imported Feed' as fallback name", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline xmlUrl="" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("Imported Feed");
  });

  test("trims whitespace from labels", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="  Spaced Feed  " xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("Spaced Feed");
  });
});

describe("OPML Parser - URL Normalization", () => {
  test("normalizes HTTPS URLs", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed" xmlUrl="https://example.com/feed/" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].url).toBe("https://example.com/feed");
  });

  test("normalizes HTTP URLs", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed" xmlUrl="http://example.com/feed/" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].url).toBe("http://example.com/feed");
  });

  test("strips URL fragments", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed" xmlUrl="https://example.com/feed#section" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].url).not.toContain("#");
  });

  test("rejects non-HTTP(S) protocols", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="FTP Feed" xmlUrl="ftp://example.com/feed" />
          <outline text="File Feed" xmlUrl="file:///etc/passwd" />
          <outline text="Valid Feed" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].name).toBe("Valid Feed");
  });

  test("rejects invalid URLs", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Invalid" xmlUrl="not-a-url" />
          <outline text="Valid" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].name).toBe("Valid");
  });

  test("handles URL with query parameters", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed" xmlUrl="https://example.com/feed?format=rss" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].url).toContain("format=rss");
  });

  test("trims URL whitespace", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed" xmlUrl="  https://example.com/feed  " />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].url).toBe("https://example.com/feed");
  });
});

describe("OPML Parser - Duplicate Handling", () => {
  test("deduplicates feeds by URL", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Feed 1" xmlUrl="https://example.com/feed" />
          <outline text="Feed 2" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
  });

  test("uses last occurrence of duplicate URL", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="First" xmlUrl="https://example.com/feed" />
          <outline text="Second" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result[0].name).toBe("Second");
  });
});

describe("OPML Parser - Import Limits", () => {
  test("respects maximum entry limit", () => {
    // Create OPML with many feeds
    let opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>`;

    for (let i = 0; i < 2000; i++) {
      opml += `<outline text="Feed ${i}" xmlUrl="https://example.com/feed${i}" />`;
    }

    opml += `</body></opml>`;

    const result = parseOpmlFeedImport(opml);

    // Should be limited (exact limit depends on CONFIG.OPML_MAX_IMPORT_ENTRIES)
    expect(result.length).toBeLessThanOrEqual(1000);
  });

  test("stops processing after reaching limit", () => {
    let opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Tech">`;

    for (let i = 0; i < 2000; i++) {
      opml += `<outline text="Feed ${i}" xmlUrl="https://example.com/feed${i}" />`;
    }

    opml += `</outline></body></opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBeLessThanOrEqual(1000);
  });
});

describe("OPML Parser - Error Handling", () => {
  test("throws error for invalid XML", () => {
    const opml = `This is not valid XML`;

    expect(() => parseOpmlFeedImport(opml)).toThrow("Invalid OPML file");
  });

  test("throws error for missing body", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <head><title>Test</title></head>
      </opml>`;

    expect(() => parseOpmlFeedImport(opml)).toThrow("OPML body is missing");
  });

  test("handles empty body", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body></body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(0);
  });

  test("handles malformed outline elements", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline />
          <outline text="Valid" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].name).toBe("Valid");
  });
});

describe("OPML Parser - Real-World Scenarios", () => {
  test("parses Feedly-style OPML export", () => {
    const opml = `<?xml version="1.0" encoding="UTF-8"?>
      <opml version="1.0">
        <head>
          <title>Feedly Feeds</title>
        </head>
        <body>
          <outline text="Tech" title="Tech">
            <outline type="rss" text="Hacker News" title="Hacker News"
                     xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com/" />
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].name).toBe("Hacker News");
    expect(result[0].category).toBe("Tech");
    expect(result[0].url).toContain("ycombinator.com");
  });

  test("parses NewsBlur-style OPML export", () => {
    const opml = `<?xml version="1.0" encoding="UTF-8"?>
      <opml version="1.0">
        <body>
          <outline text="folder" title="Tech Blogs">
            <outline type="rss" text="Ars Technica" title="Ars Technica"
                     xmlUrl="https://arstechnica.com/feed/" />
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].category).toBe("Tech Blogs");
  });

  test("handles mixed categorized and uncategorized feeds", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Standalone" xmlUrl="https://example.com/standalone" />
          <outline text="Category">
            <outline text="Categorized" xmlUrl="https://example.com/cat" />
          </outline>
          <outline text="Another" xmlUrl="https://example.com/another" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(3);
    expect(result[0].category).toBe("Uncategorized");
    expect(result[1].category).toBe("Category");
    expect(result[2].category).toBe("Uncategorized");
  });

  test("handles feeds with special characters in names", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Tech &amp; Science" xmlUrl="https://example.com/feed" />
          <outline text="News &lt;Official&gt;" xmlUrl="https://example.com/news" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(2);
    expect(result[0].name).toContain("&");
    expect(result[1].name).toContain("<");
  });

  test("handles international/unicode feed names", () => {
    const opml = `<?xml version="1.0" encoding="UTF-8"?>
      <opml version="1.0">
        <body>
          <outline text="日本のニュース" xmlUrl="https://example.jp/feed" />
          <outline text="Actualités Françaises" xmlUrl="https://example.fr/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(2);
    expect(result[0].name).toBe("日本のニュース");
    expect(result[1].name).toBe("Actualités Françaises");
  });
});

describe("OPML Parser - Edge Cases", () => {
  test("handles outline elements with no children", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Empty Category" />
          <outline text="Feed" xmlUrl="https://example.com/feed" />
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
  });

  test("handles deeply nested categories", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="Level 1">
            <outline text="Level 2">
              <outline text="Level 3">
                <outline text="Level 4">
                  <outline text="Deep Feed" xmlUrl="https://example.com/deep" />
                </outline>
              </outline>
            </outline>
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].category).toBe("Level 4");
  });

  test("handles category with empty label", () => {
    const opml = `<?xml version="1.0"?>
      <opml version="1.0">
        <body>
          <outline text="">
            <outline text="Feed" xmlUrl="https://example.com/feed" />
          </outline>
        </body>
      </opml>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
    expect(result[0].category).toBe("Uncategorized");
  });

  test("handles case-insensitive tag names", () => {
    const opml = `<?xml version="1.0"?>
      <OPML version="1.0">
        <BODY>
          <OUTLINE text="Feed" xmlUrl="https://example.com/feed" />
        </BODY>
      </OPML>`;

    const result = parseOpmlFeedImport(opml);

    expect(result.length).toBe(1);
  });
});
