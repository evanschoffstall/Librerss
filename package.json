{
  "name": "librerss",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "bun dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "next build",
    "clean": "rm -rf .next .cache .coverage",
    "start": "next start",
    "check": "bun scripts/check.ts",
    "test": "bun test",
    "test:regen": "bun run scripts/regen-pipeline-results.ts",
    "types": "tsc --noEmit",
    "lint": "bun scripts/check.ts lint",
    "lint:style": "stylelint \"src/**/*.{css,scss}\" --cache --cache-location .cache/stylelint --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier",
    "ts-prune": "bun scripts/check.ts ts-prune --config .ts-prune.json",
    "tsd": "tsd --typings next-env.d.ts",
    "staged": "lint-staged",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "scan:secretlint": "secretlint \"**/*\" --secretlintignore .secretlintignore",
    "scan:tooling": "node scripts/security-tooling.mjs",
    "scan:semgrep": "semgrep scan --config auto --error --exclude='src/__tests__' --exclude='src/components/ui' --exclude-rule=javascript.lang.security.audit.react-dangerouslysetinnerhtml.react-dangerouslysetinnerhtml --exclude-rule=typescript.react.security.audit.react-dangerouslysetinnerhtml.react-dangerouslysetinnerhtml --exclude-rule=problem-based-packs.insecure-transport.js-node.bypass-tls-verification.bypass-tls-verification --quiet src",
    "scan:gitleaks": "bunx @0xts/gitleaks-cli detect -s src --no-git -c .gitleaks.toml",
    "scan:deps": "bun audit",
    "db:provision": "bun scripts/provision-db.ts",
    "create-user": "bun scripts/create-user.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "dup": "jscpd --config .jscpd.json",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src --output-type err",
    "depgraph": "bunx madge@8 --circular --extensions ts,tsx src",
    "type-coverage": "type-coverage --at-least 98",
    "redundancy": "knip --config knip.json --cache",
    "quality:dup": "bun run dup && bun run redundancy && bun run ts-prune",
    "quality:format": "bun run format:check && bun run lint:style",
    "quality:security": "bun run scan:secretlint && bun run scan:semgrep && bun run scan:gitleaks && bun run scan:deps"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "bun scripts/check.ts lint --fix"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@lexical/code": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/markdown": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/selection": "^0.41.0",
    "@lexical/table": "^0.41.0",
    "@lexical/utils": "^0.41.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "header-generator": "^2.1.81",
    "lexical": "^0.41.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "node-tls-client": "^2.1.0",
    "pg": "^8.19.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.2.4",
    "recharts": "^3.7.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.1",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tough-cookie": "^6.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@0xts/gitleaks-cli": "^0.1.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.3",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "dependency-cruiser": "^17.3.8",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "happy-dom": "^20.7.0",
    "jscpd": "^4.0.8",
    "knip": "^5.85.0",
    "lint-staged": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.1",
    "ts-prune": "^0.10.3",
    "tsd": "^0.33.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "minimatch": "3.1.4",
    "esbuild": "0.25.12"
  },
  "packageManager": "bun@1.0.0"
}
