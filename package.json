  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "bun dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:playwright": "sh -c 'PLAYWRIGHT_NEXT_DIST_DIR=\"${PLAYWRIGHT_NEXT_DIST_DIR:-.next-playwright}\" next dev --turbopack -H 127.0.0.1 -p \"${PLAYWRIGHT_PORT:-3100}\"'",
    "build": "next build",
    "clean": "rm -rf .next .cache .coverage",
    "start": "next start",
    "check": "bun scripts/check.ts",
    "test": "bun test",
    "test:e2e": "bun scripts/run-playwright.ts",
    "test:e2e:coverage": "PLAYWRIGHT_COVERAGE_ENABLED=1 PLAYWRIGHT_COVERAGE_OUTPUT_DIR=coverage/playwright-raw PLAYWRIGHT_COVERAGE_REPORT_DIR=coverage/playwright PLAYWRIGHT_HTML_REPORT_DIR=coverage/playwright/html PLAYWRIGHT_JUNIT_REPORT_PATH=coverage/playwright-junit.xml bun scripts/run-playwright.ts",
    "test:e2e:headed": "bun scripts/run-playwright.ts --headed",
    "test:e2e:ui": "bun scripts/run-playwright.ts --ui",
    "test:regen": "bun run scripts/test-reading-pipeline-regen-results.ts",
    "db:provision": "bun scripts/db-provision.ts",
    "db:create-user": "bun scripts/db-create-user.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,jsx}": [
      "bun scripts/check.ts lint --fix"
