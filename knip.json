{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "check-suite.config.ts",
    "tests/regen-extraction-proof-runner.ts",
    "src/app/**/*.{ts,tsx}",
    "src/lib/core/server-core/index.ts",
    "scripts/**/*.{ts,mjs}"
  ],
  "project": [
    "next-env.test-d.ts",
    "src/**/*.{js,jsx,ts,tsx}",
    "scripts/**/*.{js,ts,mjs}",
    "tests/**/*.{ts,tsx}"
  ],
  "ignoreIssues": {
    "next-env.test-d.ts": ["files"],
    "src/lib/core/server-core/cache.ts": ["exports"],
    "src/lib/core/server-core/fetcher.ts": ["exports"],
    "src/lib/core/server-core/mark-stream-read.ts": ["exports"],
    "src/lib/core/server-core/records.ts": ["exports"],
    "src/lib/core/server-core/status.ts": ["exports"],
    "src/components/ui/**": ["classMembers", "exports", "files", "types"]
  },
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@0xts/gitleaks-cli",
    "@radix-ui/react-alert-dialog",
    "@lexical/code",
    "@lexical/link",
    "@lexical/list",
    "@lexical/markdown",
    "@lexical/react",
    "@lexical/rich-text",
    "@lexical/selection",
    "@lexical/table",
    "@lexical/utils",
    "@secretlint/secretlint-rule-preset-recommend",
    "lexical",
    "cmdk",
    "embla-carousel-react",
    "lint-staged",
    "lodash",
    "purgecss",
    "react-day-picker",
    "react-hook-form",
    "recharts",
    "@types/lodash",
    "jscpd",
    "postcss-load-config",
    "secretlint",
    "ts-prune",
    "tsd",
    "type-coverage"
  ],
  "treatConfigHintsAsErrors": true
}
