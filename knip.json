{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "scripts/**/*.ts"],
  "project": [
    "next-env.test-d.ts",
    "src/**/*.{js,jsx,ts,tsx}",
    "scripts/**/*.{js,ts}",
    "tests/**/*.{ts,tsx}"
  ],
  "ignoreIssues": {
    "next-env.test-d.ts": ["files"],
    "src/components/ui/**": ["classMembers", "exports", "files", "types"]
  },
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@0xts/gitleaks-cli",
    "@commitlint/cli",
    "@lexical/code",
    "@lexical/link",
    "@lexical/list",
    "@lexical/markdown",
    "@lexical/react",
    "@lexical/rich-text",
    "@lexical/selection",
    "@lexical/table",
    "@lexical/utils",
    "@secretlint/secretlint-rule-preset-recommend",
    "lexical",
    "cmdk",
    "embla-carousel-react",
    "lint-staged",
    "lodash",
    "purgecss",
    "react-day-picker",
    "react-hook-form",
    "recharts",
    "@types/lodash",
    "jscpd",
    "postcss-load-config",
    "secretlint",
    "ts-prune",
    "tsd",
    "type-coverage"
  ],
  "treatConfigHintsAsErrors": true
}
