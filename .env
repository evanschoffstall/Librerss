# Base environment defaults (committed)
# Override any value locally in .env.local

# Core app
NODE_ENV=development # Runtime mode (development, test, production).
DATABASE_URL=postgres://user:password@host:5432/dbname # PostgreSQL connection string used by the app.
DB_DRIVER=pg # Database driver: pg (default pooled TCP) or neon (Neon serverless with fetch-backed one-shot queries).
ALLOW_SIGNUP=false # Allows public user registration when true.
INVITATIONS_ENABLED=true # Allows configured admins to create secure invitation signup links when true.
INVITATION_EXPIRATION_DAYS=14 # Number of days before newly generated invitation links expire.
TRUSTED_PROXY_COUNT=1 # Number of trusted reverse proxies for client IP extraction.
DB_MAX_CONNECTIONS=1 # Maximum number of DB connections in the pool.
DB_IDLE_TIMEOUT_MS=1000 # Time in ms before idle DB clients are released.
DB_EAGER_CONNECT_CHECK=false # Runs an eager DB connect check at startup when true.

# Logging
LOG_LEVEL=warn # Application log verbosity: none, error, warn, info, verbose.
LOG_COLORS_ENABLED=false # Enables color formatting in log output (true, false, 0, 1, no, off).

# Feed settings
FEED_REFRESH_DIAGNOSTICS_ENABLED=false # Enables internal diagnostics for feed refresh behavior.
FEED_CACHE_TTL_MINUTES=30 # Server-side feed cache TTL in minutes.
NEXT_PUBLIC_FEED_REFRESH_DIAGNOSTICS_ENABLED=false # Enables client-side diagnostics for feed refresh behavior.
NEXT_PUBLIC_FEED_CACHE_TTL_MINUTES=30 # Client-side feed cache TTL in minutes.
FEED_FORCE_REFRESH_TTL_MINUTES=5 # Cooldown in minutes before a forced feed refresh is allowed.
FEED_BATCH_MAX_URLS=64 # Maximum number of feed URLs allowed in one batch request.
FEED_BATCH_CONCURRENCY=8 # Maximum parallel upstream requests during feed batch refresh.
FEED_REQUEST_TIMEOUT_MS=14000 # Timeout in ms for upstream feed requests.
MAX_FEED_RESPONSE_SIZE_BYTES=5242880 # Maximum feed response payload size in bytes.
ARTICLE_EXTRACT_CACHE_ENABLED=true # Enables article extraction response caching globally.
ARTICLE_EXTRACT_CACHE_DEV_ENABLED=true # Enables article extraction caching specifically in development mode.

# Content limits
MAX_ARTICLE_CONTENT_LENGTH=100000 # Maximum extracted/stored article content length (characters).
MAX_ARTICLES_PER_FEED=200 # Maximum number of articles retained per feed.
MAX_ALL_ARTICLES_LIMIT=500 # Maximum number of articles returned across all feeds.
MAX_ARTICLE_TITLE_LENGTH=500 # Maximum title length for article records.
MAX_ARTICLE_CONSECUTIVE_BLANK_LINES=3 # Maximum allowed consecutive blank lines in article content.
NEXT_PUBLIC_MAX_ARTICLE_CONSECUTIVE_BLANK_LINES=3 # Client-side max consecutive blank lines for article rendering.
MIN_ARTICLE_IMAGE_WIDTH_PX=151 # Minimum image width (px) to keep during article sanitization.
MIN_ARTICLE_IMAGE_HEIGHT_PX=85 # Minimum image height (px) to keep during article sanitization.
MAX_FEED_NAME_LENGTH=255 # Maximum feed/source display name length.
MAX_CATEGORY_NAME_LENGTH=255 # Maximum category name length.
OPML_MAX_IMPORT_ENTRIES=500 # Maximum number of OPML entries accepted during import.

# Authentication
SESSION_DURATION_DAYS=30 # Session lifetime in days.
PASSWORD_MIN_LENGTH=8 # Minimum password length.
PASSWORD_MAX_LENGTH=1024 # Maximum password length.
PASSWORD_COMPLEXITY_REQUIRED_TYPES=3 # Number of password character classes required.
MAX_SESSIONS_PER_USER=5 # Maximum concurrent active sessions per user.
DEV_AUTO_LOGIN_EMAIL= # Development-only email used to auto-login through the normal auth flow when paired with DEV_AUTO_LOGIN_PASSWORD.
DEV_AUTO_LOGIN_PASSWORD= # Development-only plaintext password used for auto-login. Leave empty to disable the feature.

# Email
MAX_EMAIL_LENGTH=320 # Maximum allowed email length.
LEGAL_PROFILE=generic # Legal page profile: generic for self-hosted/community deployments, official for the Librerss.com-style hosted policy.
LEGAL_DEPLOYMENT_NAME= # Optional public deployment name shown on legal pages (for example: Librerss.com).
LEGAL_OPERATOR_NAME= # Optional public operator name shown on legal pages.
OPERATOR_CONTACT_EMAIL= # Optional public legal/support contact email shown on legal pages.
PROXY_CREDENTIAL_ENCRYPTION_KEY= # Optional dedicated secret for encrypting saved proxy passwords at rest. If empty, DATABASE_URL is used as the encryption secret source.

# Rate limiting
RATE_LIMIT_DISABLED_IN_DEV=true # Disables all rate limiting when NODE_ENV=development (recommended for local development).
RATE_LIMIT_PROXY_WINDOW_MS=60000 # Universal proxy rate-limit window in milliseconds (applied to all matched routes).
RATE_LIMIT_PROXY_MAX_REQUESTS=100 # Max requests allowed per client IP within proxy rate-limit window (global protection).
RATE_LIMIT_LOGIN_WINDOW_MS=900000 # Login rate-limit window in milliseconds.
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5 # Max login attempts allowed within login rate-limit window.
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000 # Signup rate-limit window in milliseconds.
RATE_LIMIT_SIGNUP_MAX_ATTEMPTS=3 # Max signup attempts allowed within signup rate-limit window.
RATE_LIMIT_INVITATIONS_WINDOW_MS=3600000 # Invitation generation rate-limit window in milliseconds.
RATE_LIMIT_INVITATIONS_MAX_ATTEMPTS=20 # Max invitation links an admin can generate within the invitation rate-limit window.
RATE_LIMIT_FEED_WINDOW_MS=60000 # Feed mutation/read rate-limit window in milliseconds.
RATE_LIMIT_FEED_MAX_REQUESTS=30 # Max feed requests allowed within feed rate-limit window.
RATE_LIMIT_FEED_BATCH_WINDOW_MS=60000 # Feed batch endpoint rate-limit window in milliseconds.
RATE_LIMIT_FEED_BATCH_MAX_REQUESTS=40 # Max batch feed requests allowed within batch window.
RATE_LIMIT_EXTRACT_WINDOW_MS=60000 # Article extract endpoint rate-limit window in milliseconds.
RATE_LIMIT_EXTRACT_MAX_REQUESTS=10 # Max article extract requests allowed within extract window.
RATE_LIMIT_PROXY_COMPATIBILITY_WINDOW_MS=300000 # Proxy compatibility check endpoint rate-limit window in milliseconds (5 min).
RATE_LIMIT_PROXY_COMPATIBILITY_MAX_ATTEMPTS=3 # Max proxy compatibility check attempts per user within window.

# DNS validation
DNS_CACHE_TTL_MS=300000 # TTL in ms for cached DNS lookups used in SSRF validation.
DNS_LOOKUP_TIMEOUT_MS=3000 # Timeout in ms for DNS lookups.

# Request parsing
MAX_JSON_BODY_BYTES=65536 # Maximum JSON request body size in bytes.

# Batch operations
MARK_ALL_READ_LIMIT=10000 # Maximum articles affected by "mark all read" operations.

# Caching limits
DNS_CACHE_MAX_ENTRIES=10000 # Maximum number of entries in DNS cache.
MAX_FAVICON_CACHE_ENTRIES=400 # Maximum number of favicon cache entries.
FEED_LOADING_FAILSAFE_MS=20000 # Failsafe timeout in ms for feed loading operations.
